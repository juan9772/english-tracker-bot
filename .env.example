# --- CONFIGURACIÓN DE TELEGRAM ---
# Token del Bot de Telegram (se obtiene hablando con @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ID del chat grupal donde se anunciarán las rachas y penalizaciones
# (Puedes obtenerlo reenviando un mensaje del grupo a bots como @RawDataBot)
TELEGRAM_CHAT_ID=-100xxxxxxxxxx


# --- CONFIGURACIÓN DE BASE DE DATOS (VERCEL) ---
# Claves de conexión para Vercel KV (se configuran automáticamente al conectar el Storage en Vercel)
KV_URL=redis://...
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=your_kv_token_here
KV_REST_API_READ_ONLY_TOKEN=your_kv_read_only_token_here

# Usar almacenamiento local en memoria (Mock KV) para pruebas de desarrollo local sin conexión
MOCK_KV=true


# --- CONFIGURACIÓN DE SEGURIDAD (CRON) ---
# Clave secreta para autorizar la ejecución del cron (se configura en Vercel Cron Jobs)
CRON_SECRET=your_cron_secret_here


# --- CONFIGURACIÓN DE INTELIGENCIA ARTIFICIAL (GEMINI API) ---
# Clave de API de Google Gemini (Obtenla gratis en Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here


# --- CONFIGURACIÓN DE USUARIOS PARTICIPANTES ---
# Nombre de usuario de Telegram sin el "@" para cada integrante
USER_A_USERNAME=juan9772
USER_B_USERNAME=sister_username

# Nombres legibles para mostrar en los reportes
USER_A_NAME=Juan
USER_B_NAME=Sister

# Opcional: ID numérico de Telegram de los usuarios (si no tienen username configurado)
# USER_A_ID=123456789
# USER_B_ID=987654321
